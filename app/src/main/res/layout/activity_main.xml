<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Awaaz se phone chalaiye"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/serviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="Saathi chalu karo" />

        <Button
            android:id="@+id/stopButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Band karo" />

        <!-- ============ what to say ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Aise boliye"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.75"
            android:lineSpacingMultiplier="1.45"
            android:text="• WhatsApp kholo\n• Ramesh ko call karo\n• Mummy ko SMS bhejo ki main ghar aa raha hoon\n• Downloads mein Bills naam ka folder banao\n• resume wali file ko Documents mein move karo\n• Downloads mein kya hai dikhao\n• likho namaste kaise ho" />

        <!-- ============ permissions ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Permissions"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.45"
            android:textSize="13sp" />

        <Button
            android:id="@+id/permissionsButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mic, contacts, call, SMS" />

        <Button
            android:id="@+id/overlayButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bubble dikhane ki ijazat" />

        <Button
            android:id="@+id/storageButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="All files access (file ka kaam)" />

        <Button
            android:id="@+id/accessibilityButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Accessibility (optional)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.35"
            android:text="Accessibility sirf do cheezon ke liye hai: kisi bhi app ke text box mein likhna, aur WhatsApp ka send dabana. Baaki sab iske bina chalta hai. Yeh permission screen reader jaisi hoti hai — soch samajh kar dein." />

        <!-- ============ settings ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Setting"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/confirmSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Call, SMS aur delete se pehle poocho" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/speakSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Jawab bol kar sunao" />

        <TextView
            android:id="@+id/engineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.75"
            android:lineSpacingMultiplier="1.35" />

        <EditText
            android:id="@+id/geminiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Gemini API key (optional)"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/saveKeyButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Key save karo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.35"
            android:text="Key ke bina bhi app chalegi, bas seedhe commands samajhegi. Key hone par ghumi-phiri baat bhi samajh legi. Key sirf is phone mein rehti hai; sirf aapka bola hua vaakya aur apps ke naam bheje jaate hain — contacts aur files kabhi nahi." />

        <!-- ============ history ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Pichhle commands"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.3"
            android:text="Kuch galat hua toh yahan dikhega ki app ne kya suna — aksar wahi asli wajah hoti hai." />

        <TextView
            android:id="@+id/historyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/clearHistoryButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="History saaf karo" />
    </LinearLayout>
</ScrollView>
