<?xml version="1.0" encoding="utf-8"?>
<!--
  v3.7 Siri-style: root wrap_content hai, service window bhi
  WRAP_CONTENT hai — chhota kaam ho toh panel chhota hi rahega,
  screen cover nahi karega. ScrollView ki height service mein
  45% par cap hoti hai, taaki lambi list buttons ko bahar na dhakele.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/panelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.25"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/panelHeard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#9AFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/panelScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/panelDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#E0FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </ScrollView>

    <!--
      Shown when more than one thing could have been meant — two apps with
      similar names, or two contacts. Guessing between them is what sent
      "WhatsApp Business kholo" to plain WhatsApp, so now the user picks.
    -->
    <LinearLayout
        android:id="@+id/optionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Only shown when something is waiting for a yes or no. -->
    <LinearLayout
        android:id="@+id/confirmRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/panelYes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#2E7D52"
            android:gravity="center"
            android:padding="14dp"
            android:text="Haan, karo"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/panelNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#4A3030"
            android:gravity="center"
            android:padding="14dp"
            android:text="Nahi"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!--
          The user could close this panel but the floating mic stayed on screen
          with no visible way to get rid of it. Long-pressing the bubble works,
          but nothing said so. This button does say so.
        -->
        <!-- v3.8: neeche ki patti chhoti aur halki — pehle 12dp
             padding wali badi patti hi panel ko bhari banati thi. -->
        <TextView
            android:id="@+id/panelHideMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Mic chhupao"
            android:textColor="#C9D6FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panelAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Phir se boliye"
            android:textColor="#7FD4A8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panelClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Hatao"
            android:textColor="#FF9A8A"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
